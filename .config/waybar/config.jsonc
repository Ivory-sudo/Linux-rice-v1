{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 4,
    "exclusive": true,
    "gtk-layer-shell": true,

    "modules-left": [
        "custom/power",
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock",
        "mpris",
    ],
    "modules-right": [
        "custom/waycat",
        "cpu",
        "memory",
        "custom/autoclicker",
        "pulseaudio",
        "network"
    ],

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "all-outputs": true
    },

    "hyprland/window": {
        "format": "{}",
        "max-length": 50,
        "separate-outputs": true
    },

    "clock": {
        "format": "{:%I:%M %p - %a, %d %b}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

	"custom/waycat": {
        "exec":"~/.config/waybar/scripts/catloop.sh",
        "spacing": 1,
        "format": "{}",
        "tooltip": true,
    },

    "cpu": {
        "format": "CPU: {usage}%",
        "interval": 2
    },

    "memory": {
        "format": "RAM: {percentage}%",
        "interval": 2
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },

    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "󰈀 Wired",
        "format-disconnected": "󰖪 Disconnected",
        "tooltip-format": "{ipaddr}",
        "on-click": "kitty -e nmtui"
    },

    "mpris": {
        "format": "{player_icon} {title} - {artist}",
        "max-length": 40,
        "player-icons": { "default": "▶", "spotify": "" }
    },

    "custom/power": {
    "format": "⏻",
    "on-click": "wlogout",
    "tooltip": false
    },

    "custom/autoclicker": {
    "exec": "~/.config/waybar/scripts/autoclicker_status.sh",
    "return-type": "json",
    "interval": 2,
    "on-click": "~/.config/waybar/scripts/autoclicker_toggle.sh",
    "tooltip": true
    },
}
